# API Keys for ShadowScope
VT_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
SHODAN_API_KEY=your_shodan_api_key_here
IPQS_API_KEY=your_ipqualityscore_api_key_here
IPINFO_API_KEY=your_ipinfo_api_key_here
FILE_SCAN_IO=your_filescan_io_api_key_here
HYBRID_ANALYSIS_API_KEY=your_hybrid_analysis_api_key_here
JOE_SANDBOX_CLOUD_API_KEY=your_joe_sandbox_api_key_here
GREYNOISE_API_KEY=your_greynoise_api_key_here
CENSYS_API_KEY=your_censys_personal_access_token_here
OTX_API_KEY=your_alienvault_otx_api_key_here
URLSCAN_API_KEY=your_urlscan_io_api_key_here
# Pulsedive — anonymous queries work rate-limited; key unlocks more quota.
PULSEDIVE_API_KEY=

# Passive DNS — primary path is Mnemonic free tier (no auth required, see
# docs/API_KEYS.md). CIRCL Passive DNS is reserved as a future secondary
# path; v1 of the module only implements Mnemonic, but these placeholders
# are wired so the module can authenticate against CIRCL once that path
# lands without a follow-up .env.example edit.
# CIRCL_USERNAME=
# CIRCL_PASSWORD=

# REST API (only used by `shadowscope serve`)
# SHADOWSCOPE_API_TOKEN=
# SHADOWSCOPE_CORS_ORIGINS=*

# LLM summary (--summary flag) — defaults are fine for typical local Ollama install
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Cache TTL — hours a cached enrichment row stays fresh before refetch.
# Default: 24. Float values supported (e.g. 0.5 = 30 minutes).
# CACHE_TTL_HOURS=24

# Cache retention — days before old enrichment rows are auto-deleted by
# the opportunistic janitor inside `core/enrich.maybe_auto_prune`. Runs
# at most once per process per workspace per 24h. Default: 90.
# RETENTION_DAYS=90

# Set AUTO_PRUNE=0 to disable the in-process janitor entirely (e.g. when
# you drive retention from cron via `shadowscope cache prune` instead).
# AUTO_PRUNE=1

# Typosquat watchlist — comma-separated org domains. Lookalikes
# (paypa1.com, rnicrosoft.com, g00gle.com, etc.) get flagged via the
# Heuristics module. Leave blank to disable.
# WATCHLIST_DOMAINS=

# Allowlist — skip enrichment entirely for known-internal IOCs. Saves
# API quota on bulk enrichment of corp ranges. Domain matches include
# subdomains; CIDR matches IPv4 + IPv6.
# ALLOWLIST_CIDRS=10.0.0.0/8,192.168.0.0/16,172.16.0.0/12
# ALLOWLIST_DOMAINS=corp.example.com,internal.lan
