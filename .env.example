VT_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
IPQS_API_KEY=
IPINFO_API_KEY=
FILE_SCAN_IO=
HYBRID_ANALYSIS_API_KEY=
JOE_SANDBOX_CLOUD_API_KEY=
GREYNOISE_API_KEY=
OTX_API_KEY=
URLSCAN_API_KEY=
PULSEDIVE_API_KEY=
# AbstractAPI products — separate keys per product on their dashboard.
# ABSTRACT_IP_INTELLIGENCE feeds the IP enrichment module today;
# Email/Phone are future modules.
ABSTRACT_IP_INTELLIGENCE=
ABSTRACT_EMAIL_REPUTATION=
ABSTRACT_PHONE_INTELLIGENCE=
SHADOWSCOPE_API_TOKEN=
SHADOWSCOPE_CORS_ORIGINS=*
SHADOWSCOPE_HOST_PORT=8765
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Cache TTL — hours a cached enrichment row stays "fresh" before refetch.
# Default: 24. Float values supported (e.g. 0.5 for 30-minute TTL).
# Set CACHE_TTL_HOURS=0 or leave blank to fall back to the default.
CACHE_TTL_HOURS=24

# Cache retention — days before old enrichment rows are deleted by the
# in-process janitor (`maybe_auto_prune` in core/enrich.py). Runs at most
# once per process per workspace per 24h. Set RETENTION_DAYS=0 to fall
# back to the 90-day default. Set AUTO_PRUNE=0 to disable the janitor
# entirely (e.g. when driving retention via cron + `shadowscope cache prune`).
RETENTION_DAYS=90
AUTO_PRUNE=1

# Typosquat watchlist — comma-separated org domains to compare new
# domains against. Lookalikes (paypa1.com, rnicrosoft.com, g00gle.com)
# get flagged via the Heuristics module. Leave blank to disable.
WATCHLIST_DOMAINS=

# Allowlist — skip enrichment for known-internal IOCs. Useful for
# bulk-enriching mixed logs where most of the input is your own
# infrastructure. Domain matches include subdomains; CIDR is IPv4+IPv6.
ALLOWLIST_CIDRS=
ALLOWLIST_DOMAINS=

# Tor exit-node list refresh window (hours). Default 24.
TOR_LIST_TTL_HOURS=24

# abuse.ch Feodo Tracker + SSL Blacklist refresh windows (hours). Default 24.
FEODO_LIST_TTL_HOURS=24
SSLBL_LIST_TTL_HOURS=24
