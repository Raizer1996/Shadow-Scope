VT_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
IPQS_API_KEY=
IPINFO_API_KEY=
FILE_SCAN_IO=
HYBRID_ANALYSIS_API_KEY=
JOE_SANDBOX_CLOUD_API_KEY=
GREYNOISE_API_KEY=
OTX_API_KEY=
URLSCAN_API_KEY=
SHADOWSCOPE_API_TOKEN=
SHADOWSCOPE_CORS_ORIGINS=*
SHADOWSCOPE_HOST_PORT=8765
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Cache TTL — hours a cached enrichment row stays "fresh" before refetch.
# Default: 24. Float values supported (e.g. 0.5 for 30-minute TTL).
# Set CACHE_TTL_HOURS=0 or leave blank to fall back to the default.
CACHE_TTL_HOURS=24

# Typosquat watchlist — comma-separated org domains to compare new
# domains against. Lookalikes (paypa1.com, rnicrosoft.com, g00gle.com)
# get flagged via the Heuristics module. Leave blank to disable.
WATCHLIST_DOMAINS=
